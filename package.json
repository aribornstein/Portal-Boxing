{
  "name": "portal-boxing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev up --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts vite.config.ts playwright.config.ts vitest.config.ts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "test:performance": "vitest run tests/performance",
    "assets:validate": "tsx scripts/assets/validate-assets.ts",
    "assets:audio": "tsx scripts/assets/generate-audio.ts",
    "assets:build": "tsx scripts/assets/build-manifests.ts",
    "assets:budget": "tsx scripts/assets/calculate-budgets.ts",
    "assets:licenses": "tsx scripts/assets/build-license-manifest.ts --check",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run assets:validate && npm run assets:budget && npm run build",
    "release:check": "npm run validate && npm run assets:licenses && npm run test:e2e"
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "onnxruntime-web": "^1.27.0",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iwsdk/cli": "0.4.2",
    "@iwsdk/reference": "0.4.2",
    "@iwsdk/vite-plugin-dev": "0.4.2",
    "@iwsdk/vite-plugin-uikitml": "0.4.2",
    "@meta-quest/hzdb": "^1.0.0",
    "@playwright/test": "^1.62.0",
    "@types/three": "*",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.4",
    "vite-plugin-mkcert": "^1.17.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
