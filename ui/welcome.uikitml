<style>
  .panel-container {
    align-items: flex-start;
    padding: 3;
    width: 72;
    display: flex;
    flex-direction: column;
    background-color: #070b0e;
    border-color: #55cdf6;
    border-width: 0.18;
    border-radius: 0.8;
  }

  .heading {
    font-size: 5;
    font-weight: bold;
    color: #fafafa;
    text-align: left;
  }

  .kicker {
    font-size: 1.8;
    color: #55cdf6;
    text-align: left;
    margin-bottom: 0.5;
  }

  .state {
    width: 100%;
    padding: 1.2;
    margin-top: 1.2;
    background-color: #111a1f;
    border-color: #263940;
    border-width: 0.1;
  }

  .state-label {
    font-size: 1.6;
    color: #6f8791;
  }

  .state-value {
    font-size: 2.2;
    color: #f2f0e9;
    margin-top: 0.3;
  }

  .status {
    font-size: 2;
    color: #8ddfff;
    margin-top: 1.2;
    margin-bottom: 0.3;
  }

  .action {
    width: 100%;
    padding: 1.4;
    margin-top: 0.8;
    background-color: #55cdf6;
    color: #071015;
    border-radius: 0.4;
    border-width: 0.1;
    border-color: #8ddfff;
    font-size: 2.2;
    font-weight: bold;
    text-align: center;
    cursor: pointer;
  }

  .secondary {
    background-color: #111a1f;
    color: #dbe7eb;
    border-color: #3b525c;
  }

  .debug {
    background-color: #372b0b;
    color: #ffd966;
    border-color: #d9a92f;
  }

  .danger {
    background-color: #481414;
    color: #ffb0a2;
    border-color: #ff6b51;
  }
</style>
<div class="panel-container">
  <span class="kicker">PORTALAR / ROOM SAFETY</span>
  <span class="heading">SET THE STAGE</span>
  <div class="state">
    <span class="state-label">APPLICATION</span>
    <span id="application" class="state-value">READY</span>
  </div>
  <div class="state">
    <span class="state-label">LIVE XR</span>
    <span id="xr-status" class="state-value">Waiting for session</span>
  </div>
  <span id="status" class="status">Keep the combat zone clear.</span>
  <button id="capture-button" class="action">CAPTURE LIVE ROOM</button>
  <button id="confirm-button" class="action">CONFIRM LABELS + SAFETY</button>
  <button id="bypass-button" class="action debug">DEBUG SAFETY: ENFORCED</button>
  <button id="bypass-continue-button" class="action danger">CONTINUE WITHOUT ROOM SAFETY</button>
  <button id="depth-debug-button" class="action secondary">DEPTH CUBES: OFF</button>
  <button id="portal-button" class="action">OPEN PORTAL</button>
  <button id="next-button" class="action">NEXT STAGE</button>
  <button id="restart-button" class="action secondary">RESTART SETUP</button>
  <button id="exit-button" class="action secondary">EXIT TO BROWSER</button>
</div>
